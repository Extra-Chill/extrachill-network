      "args": [
        "url=http://studio.extrachill.com/",
        "route-host=studio.extrachill.com",
        "network-policy=block",
        "allow-host=studio.extrachill.com",
        "auth=wordpress-admin",
        "auth-user-id=220",
        "step-timeout=30s",
        "timeout=120s",
        "capture=steps,console,errors,network,html,screenshot,dom-snapshot",
