      "metadata": { "kind": "journey-browser-step", "step": "gardner-social-tab-access" },
      "args": [
        "url=http://studio.extrachill.com/",
        "route-host=studio.extrachill.com",
        "network-policy=block",
        "allow-host=studio.extrachill.com",
        "auth=wordpress-admin",
        "auth-user-id=201",
        "step-timeout=30s",
        "timeout=120s",
        "capture=steps,console,errors,network,html,screenshot,dom-snapshot",
        "steps-json=[{\"kind\":\"navigate\",\"url\":\"http://studio.extrachill.com/\",\"waitFor\":\"load\"},{\"kind\":\"expect\",\"selector\":\"[data-ec-studio-root][data-can-brand-socials=\\\"true\\\"]\",\"state\":\"attached\"},{\"kind\":\"waitFor\",\"selector\":\"[data-ec-studio-root][data-ec-studio-mounted=\\\"true\\\"]\"},{\"kind\":\"expect\",\"selector\":\".ec-tabs__tab:has-text(\\\"Socials\\\")\",\"state\":\"visible\"},{\"kind\":\"click\",\"selector\":\".ec-tabs__tab:has-text(\\\"Socials\\\")\"},{\"kind\":\"waitFor\",\"selector\":\".ec-studio-socials-layout\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"Instagram\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"Bluesky\\\")\",\"state\":\"visible\"},{\"kind\":\"screenshot\",\"name\":\"gardner-social-operator-access\"}]"
      ]
