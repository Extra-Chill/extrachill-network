{
  "schema": "extrachill-network/journey/v1",
  "id": "gardner-social-operator",
  "title": "Gardner Studio social-operator: approve, schedule, deliver, retry, and reconcile a cross-platform post",
  "description": "Walks Chris Gardner through Studio's real social-operations surface -- access/denial boundaries, a due-cron scheduled cross-post, a partial (Instagram-delivered, Bluesky-failed) delivery, and a safe retry to a fully-delivered, correctly-attributed final state -- on the real studio.extrachill.com site inside the full 11-site network. Ported from extrachill-studio tests/wp-codebox/chris-gardner-social-operator*.json (a standalone single-plugin wp-codebox recipe using its own multisite-convert bootstrap and adversarial-campaign extension) onto this rig's journey contract (extrachill-network#293). The deterministic scenario matrix is preserved; the old recipe's adaptive/adversarial-exploration campaign and typed wp_upload_dir() artifact ledgers are dropped -- see evidence/FINDINGS.md.",
  "origin": {
    "repository": "Extra-Chill/extrachill-studio",
    "files": [
      "tests/wp-codebox/chris-gardner-social-operator.json",
      "tests/wp-codebox/chris-gardner-social-operator-setup.php",
      "tests/wp-codebox/chris-gardner-social-operator-deliver.php",
      "tests/wp-codebox/chris-gardner-social-operator-reload.php",
      "tests/wp-codebox/chris-gardner-social-operator-provider-stub.php",
      "tests/wp-codebox/chris-gardner-social-operator-provider-contract.php",
      "tests/wp-codebox/chris-gardner-social-operator-contract.test.mjs",
      "tests/wp-codebox/chris-gardner-persona.json",
      "tests/wp-codebox/chris-gardner-persona-seed.php",
      "tests/wp-codebox/README.md"
    ],
    "mergedIn": "extrachill-network#293"
  },
  "persona": {
    "id": "extra-chill-users/chris-gardner",
